# Dependensi (diinstal ulang via composer/npm)
/vendor/
/node_modules/

# Konfigurasi lokal berisi kredensial
/config/config.php

# File runtime
/storage/logs/*.log
# Database test dan jurnal sementara tidak ikut repo (database dev ikut repo)
/storage/database/*_test.sqlite
/storage/database/*.sqlite-journal
/storage/database/*.sqlite-wal
/storage/database/*.sqlite-shm
/public/uploads/barang/*
!/public/uploads/barang/.gitkeep
!/public/uploads/barang/.htaccess
!/public/uploads/barang/sample-*.png

# Hasil test dan laporan (dibuat otomatis, tidak dipakai produksi)
/.phpunit.cache/
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Folder test dan dokumen yang tidak terkait produksi
# Dokumentasi tidak ikut repo (atas permintaan)
docs/
docs/test/
**/test/
*.tmp
*.log
tmp/
temp/
tests

# Editor dan IDE
.idea/
.vscode/

# Instruksi untuk agent AI (lokal, tidak ikut repo)
/AGENTS.md
/CLAUDE.md

# OS
.DS_Store
Thumbs.db
